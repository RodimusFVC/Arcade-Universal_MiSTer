<misterromdescription>
    <name>Space Raider</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Space Raider</series>
    <year>1982</year>
    <manufacturer>Universal</manufacturer>
    <category>Shooter</category>

    <setname>sraider</setname>
    <parent>sraider</parent>
    <mameversion>0289</mameversion>
    <rbf>Universal</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="DF,FF">
        <dip name="Difficulty" bits="0,1" ids="Easy,Medium,Hard,Hardest" values="3,2,1,0"/>
        <dip name="High Score Names" bits="2" ids="3 Letters,10 Letters"/>
        <dip name="Allow Continue" bits="3" ids="No,Yes" values="1,0"/>
        <dip name="Unknown" bits="4" ids="Off,On" values="1,0"/>
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="6,7" ids="2,3,4,5" values="0,3,2,1"/>
        <dip name="Coin A" bits="8,11" ids="4C/1C,3C/1C,2C/1C,3C/2C,2C/2C,1C/1C,1C/2C,1C/3C,1C/4C,1C/5C,Free Play" values="6,8,10,7,9,15,14,13,12,11,0"/>
        <dip name="Coin B" bits="12,15" ids="4C/1C,3C/1C,2C/1C,3C/2C,2C/2C,1C/1C,1C/2C,1C/3C,1C/4C,1C/5C,Free Play" values="6,8,10,7,9,15,14,13,12,11,0"/>
    </switches>

