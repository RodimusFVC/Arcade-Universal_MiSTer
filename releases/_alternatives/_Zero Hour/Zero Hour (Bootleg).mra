<misterromdescription>
    <name>Zero Hour (Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Zero Hour</series>
    <year>1980</year>
    <manufacturer>bootleg (Inder SA)</manufacturer>
    <category>Shooter</category>

    <setname>zerohouri</setname>
    <parent>zerohour</parent>
    <mameversion>0289</mameversion>
    <rbf>Universal</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="C7,FF">
        <dip name="Cabinet" bits="3" ids="Upright,Cocktail"/>
        <dip name="Bonus Life" bits="4,5" ids="No Bonus,5000,8000,10000" values="0,3,2,1"/>
        <dip name="Lives" bits="6,7" ids="2,3,4,5" values="0,3,2,1"/>
        <dip name="Coin A" bits="8,11" ids="4C/1C,3C/1C,2C/1C,3C/2C,1C/1C,2C/3C,1C/2C,1C/3C,1C/4C,1C/5C" values="6,8,10,7,15,9,14,13,12,11"/>
        <dip name="Coin B" bits="12,15" ids="4C/1C,3C/1C,2C/1C,3C/2C,1C/1C,2C/3C,1C/2C,1C/3C,1C/4C,1C/5C" values="6,8,10,7,15,9,14,13,12,11"/>
    </switches>

