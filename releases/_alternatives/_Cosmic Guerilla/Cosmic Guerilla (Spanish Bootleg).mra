<misterromdescription>
    <name>Cosmic Guerilla (Spanish Bootleg)</name>
    <region>Spain</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Cosmic Guerilla</series>
    <year>1979</year>
    <manufacturer>bootleg (Inder)</manufacturer>
    <category>Shooter</category>

    <setname>cosmicgi</setname>
    <parent>cosmicg</parent>
    <mameversion>0289</mameversion>
    <rbf>Universal</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way</joystick>
    <special_controls></special_controls>
    <num_buttons>1</num_buttons>
    <buttons names="Fire,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="3F,F8">
        <dip name="Bonus Life" bits="4,5" ids="1000,1500,2000,None" values="1,2,3,0"/>
        <dip name="Coinage" bits="6" ids="2C/1C,1C/1C" values="1,0"/>
        <dip name="Lives" bits="7" ids="3,5"/>
        <dip name="Cabinet" bits="9" ids="Upright,Cocktail"/>
    </switches>

    <!-- Index 0: MAME regions, layout in rtl/universal_board.sv -->
    <rom index="0" md5="none" zip="cosmicgi.zip|cosmicg.zip">
        <part crc="4bda1711" name="1g118.2h"/>
        <part crc="3c10b2ba" name="2g118.3h"/>
        <part crc="82a49b48" name="3.4h"/>
        <part crc="42bb0611" name="4g118.5h"/>
        <part crc="b1c00fbf" name="5.6h"/>
        <part crc="f03454ce" name="6.7h"/>
        <part crc="84656c97" name="7.8h"/>
        <part crc="7f48307c" name="8g128.9h"/>
        <part repeat="0x6000">00</part>
        <part crc="689c2c96" name="cosmicg9.bin"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Universal.sv) -->
    <rom index="1">
        <part>
            12 10 00 00 FF 3F F8 FF FF FF 80 00 01 80 80 80
            00 00 00 00 13 14 05 04 03 0D 0C 0B 00 00 00 00
            11 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00
        </part>
    </rom>

    <remark>Cosmic Guerilla (Spanish Bootleg) (Inder Bootleg)</remark>
    <mratimestamp>20261011000000</mratimestamp>
</misterromdescription>
