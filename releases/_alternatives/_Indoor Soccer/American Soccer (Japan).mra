<misterromdescription>
    <name>American Soccer (Japan)</name>
    <region>Japan</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Indoor Soccer</series>
    <year>1987</year>
    <manufacturer>Universal</manufacturer>
    <category>Sports</category>

    <setname>asoccer</setname>
    <parent>idsoccer</parent>
    <mameversion>0289</mameversion>
    <rbf>Universal</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls>twin stick</special_controls>
    <num_buttons>6</num_buttons>
    <buttons names="Fire,Button 2,R Right,R Left,Coin,Start 1P,Start 2P,Pause,R Down,R Up,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,FF,FF">
        <dip name="Freeze" bits="3" ids="Off,On" values="1,0"/>
        <dip name="Difficulty" bits="8,9" ids="Easy,Medium,Hard,Hardest" values="3,2,1,0"/>
        <dip name="Flip Screen" bits="11" ids="Off,On" values="1,0"/>
        <dip name="Real Game Time" bits="14,15" ids="1:00,2:00,2:30,3:00"/>
        <dip name="Joysticks" bits="10" ids="Single,Dual"/>
        <dip name="Demo Sounds" bits="13" ids="Off,On"/>
        <dip name="Coin B" bits="16,19" ids="4C/1C,3C/1C,2C/1C,3C/2C,1C/1C,2C/3C,1C/2C,1C/3C,1C/4C,1C/5C,1C/6C,Free Play" values="5,7,9,6,15,8,14,13,12,11,10,0"/>
        <dip name="Coin A" bits="20,23" ids="4C/1C,3C/1C,2C/1C,3C/2C,1C/1C,2C/3C,1C/2C,1C/3C,1C/4C,1C/5C,1C/6C,Free Play" values="5,7,9,6,15,8,14,13,12,11,10,0"/>
    </switches>

