<misterromdescription>
    <name>Mr. Do! Vs. Unicorns (Japan)</name>
    <region>Japan</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Mr. Do's Castle</series>
    <year>1983</year>
    <manufacturer>Universal</manufacturer>
    <category>Platform</category>

    <setname>douni</setname>
    <parent>docastle</parent>
    <mameversion>0289</mameversion>
    <rbf>Universal</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Rack Test" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,DF,FF">
        <dip name="Freeze" bits="3" ids="Off,On" values="1,0"/>
        <dip name="Difficulty" bits="8,9" ids="Easy,Medium,Hard,Hardest" values="3,2,1,0"/>
        <dip name="Rack Test" bits="10" ids="Off,On" values="1,0"/>
        <dip name="Bonus Credit for Diamond" bits="11" ids="No,Yes"/>
        <dip name="Difficulty of EXTRA" bits="12" ids="Easy,Difficult" values="1,0"/>
        <dip name="Cabinet" bits="13" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="14,15" ids="2,3,4,5" values="0,3,2,1"/>
        <dip name="Coin B" bits="16,19" ids="4C/1C,3C/1C,2C/1C,3C/2C,1C/1C,2C/3C,1C/2C,1C/3C,1C/4C,1C/5C,Free Play" values="6,8,10,7,15,9,14,13,12,11,0"/>
        <dip name="Coin A" bits="20,23" ids="4C/1C,3C/1C,2C/1C,3C/2C,1C/1C,2C/3C,1C/2C,1C/3C,1C/4C,1C/5C,Free Play" values="6,8,10,7,15,9,14,13,12,11,0"/>
    </switches>

