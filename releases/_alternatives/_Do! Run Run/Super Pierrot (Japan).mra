<misterromdescription>
    <name>Super Pierrot (Japan)</name>
    <region>Japan</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Do! Run Run</series>
    <year>1987</year>
    <manufacturer>Universal</manufacturer>
    <category>Maze</category>

    <setname>spiero</setname>
    <parent>dorunrun</parent>
