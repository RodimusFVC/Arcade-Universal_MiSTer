    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="FF,DF,FF">
        <dip name="Freeze" bits="3" ids="Off,On" values="1,0"/>
        <dip name="Difficulty" bits="8,9" ids="Easy,Medium,Hard,Hardest" values="3,2,1,0"/>
        <dip name="Difficulty of EXTRA" bits="12" ids="Easy,Difficult" values="1,0"/>
        <dip name="Cabinet" bits="13" ids="Upright,Cocktail"/>
        <dip name="Demo Sounds" bits="10" ids="Off,On"/>
        <dip name="Flip Screen" bits="11" ids="Off,On" values="1,0"/>
        <dip name="Special" bits="14" ids="Given,Not Given" values="1,0"/>
        <dip name="Lives" bits="15" ids="3,5" values="1,0"/>
        <dip name="Coin B" bits="16,19" ids="4C/1C,3C/1C,2C/1C,3C/2C,1C/1C,2C/3C,1C/2C,1C/3C,1C/4C,1C/5C,Free Play" values="6,8,10,7,15,9,14,13,12,11,0"/>
        <dip name="Coin A" bits="20,23" ids="4C/1C,3C/1C,2C/1C,3C/2C,1C/1C,2C/3C,1C/2C,1C/3C,1C/4C,1C/5C,Free Play" values="6,8,10,7,15,9,14,13,12,11,0"/>
    </switches>

