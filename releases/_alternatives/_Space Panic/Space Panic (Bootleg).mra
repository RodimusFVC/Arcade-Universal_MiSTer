        <part repeat="0x1800">00</part>
        <part crc="acea9df4" name="11.7m"/>
        <part crc="e83423d0" name="12.5m"/>
        <part crc="c9631c2d" name="10.8m"/>
        <part crc="eec78b4c" name="9.9m"/>
        <part crc="35d43d2f" name="mmi6330.5l"/>
    </rom>

    <!-- Index 1: board variant, flags, input map (see Arcade-Universal.sv) -->
