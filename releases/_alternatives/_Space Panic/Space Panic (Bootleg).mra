<misterromdescription>
    <name>Space Panic (Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Space Panic</series>
    <year>1980</year>
    <manufacturer>bootleg</manufacturer>
    <category>Platform</category>

    <setname>panicbl</setname>
    <parent>panic</parent>
    <mameversion>0289</mameversion>
    <rbf>Universal</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="40">
        <dip name="Coin A" bits="0,2" ids="1C/1C,2C/3C,1C/2C,1C/3C,1C/4C,1C/5C" values="0,5,1,2,3,4"/>
        <dip name="Cabinet" bits="3" ids="Upright,Cocktail"/>
        <dip name="Bonus Life" bits="4" ids="3000,5000"/>
        <dip name="Lives" bits="5" ids="3,4"/>
        <dip name="Coin B" bits="6,7" ids="2C/1C,1C/1C,1C/2C,1C/3C"/>
    </switches>

    <!-- Index 0: MAME regions, layout in rtl/universal_board.sv -->
    <rom index="0" md5="none" zip="panicbl.zip|panic.zip">
