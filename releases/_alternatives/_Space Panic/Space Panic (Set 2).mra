        <dip name="Cabinet" bits="3" ids="Upright,Cocktail"/>
        <dip name="Bonus Life" bits="4" ids="3000,5000"/>
        <dip name="Lives" bits="5" ids="3,4"/>
        <dip name="Coin B" bits="6,7" ids="2C/1C,1C/1C,1C/2C,1C/3C"/>
    </switches>

