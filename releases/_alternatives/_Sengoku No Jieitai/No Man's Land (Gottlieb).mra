        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Bonus Life" bits="0,1" ids="3000,5000,8000,None" values="1,2,3,0"/>
        <dip name="Lives" bits="4" ids="2,3"/>
    </switches>

