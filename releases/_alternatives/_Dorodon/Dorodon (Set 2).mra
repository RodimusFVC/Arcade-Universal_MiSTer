    <rbf>Universal</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>4-way</joystick>
    <special_controls></special_controls>
    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Rack Test" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="DF,FF">
        <dip name="Difficulty" bits="0,1" ids="Easy,Medium,Hard,Hardest" values="3,2,1,0"/>
        <dip name="Bonus Life" bits="2" ids="20000,30000" values="1,0"/>
        <dip name="Rack Test (Cheat)" bits="3" ids="Off,On" values="1,0"/>
        <dip name="Freeze" bits="4" ids="Off,On" values="1,0"/>
        <dip name="Cabinet" bits="5" ids="Upright,Cocktail"/>
        <dip name="Free Play" bits="6" ids="No,Yes" values="1,0"/>
        <dip name="Lives" bits="7" ids="3,5" values="1,0"/>
        <dip name="Coin B" bits="8,11" ids="4C/1C,3C/1C,2C/1C,3C/2C,1C/1C,2C/3C,1C/2C,1C/3C,1C/4C,1C/5C" values="6,8,10,7,15,9,14,13,12,11"/>
        <dip name="Coin A" bits="12,15" ids="4C/1C,3C/1C,2C/1C,3C/2C,1C/1C,2C/3C,1C/2C,1C/3C,1C/4C,1C/5C" values="6,8,10,7,15,9,14,13,12,11"/>
    </switches>

