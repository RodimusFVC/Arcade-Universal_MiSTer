    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Dorodon</series>
    <year>1982</year>
    <manufacturer>UPL (Falcon license?)</manufacturer>
    <category>Maze</category>

    <setname>dorodon2</setname>
