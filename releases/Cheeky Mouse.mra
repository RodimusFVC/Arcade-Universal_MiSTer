        <dip name="Cabinet" bits="4" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Demo Sounds" bits="5" ids="Off,On"/>
        <dip name="Bonus Life" bits="6,7" ids="3000,4500,6000,None" values="1,2,3,0"/>
    </switches>

