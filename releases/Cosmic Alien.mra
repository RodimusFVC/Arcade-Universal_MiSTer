        <dip name="Coinage" bits="2,3" ids="2C/1C,1C/1C,1C/2C" values="2,3,1"/>
        <dip name="Bonus Life" bits="4,5" ids="5000,10000,15000,None" values="3,2,1,0"/>
    </switches>

