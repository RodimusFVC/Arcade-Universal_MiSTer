    <num_buttons>0</num_buttons>
    <buttons names="Not Used,Not Used,Not Used,Not Used,Coin,Start 1P,Start 2P,Pause,Not Used,Not Used,Not Used" default="A,B,X,Y,Select,Start,R,L"/>

    <switches default="F7,FF">
        <dip name="Difficulty" bits="0,1" ids="Easy,Medium,Hard,Hardest" values="3,2,1,0"/>
        <dip name="High Score Names" bits="2" ids="3 Letters,10 Letters"/>
        <dip name="Cabinet" bits="3" ids="Upright,Cocktail"/>
        <dip name="unused1?" bits="4" ids="Off,On" values="1,0"/>
        <dip name="unused2?" bits="5" ids="Off,On" values="1,0"/>
        <dip name="Lives" bits="6,7" ids="2,3,4,5" values="0,3,2,1"/>
        <dip name="Coin B" bits="8,11" ids="4C/1C,3C/1C,2C/1C,3C/2C,2C/2C,1C/1C,2C/3C,1C/2C,1C/3C,1C/4C,1C/5C" values="5,7,10,6,9,15,8,14,13,12,11"/>
        <dip name="Coin A" bits="12,15" ids="4C/1C,3C/1C,2C/1C,3C/2C,2C/2C,1C/1C,2C/3C,1C/2C,1C/3C,1C/4C,1C/5C" values="5,7,10,6,9,15,8,14,13,12,11"/>
    </switches>

