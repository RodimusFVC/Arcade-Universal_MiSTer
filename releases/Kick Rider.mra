<misterromdescription>
    <name>Kick Rider</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Kick Rider</series>
    <year>1984</year>
    <manufacturer>Universal</manufacturer>
    <category>Sports</category>

    <setname>kickridr</setname>
    <parent>kickridr</parent>
