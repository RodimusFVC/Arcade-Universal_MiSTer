    <switches default="FF,DF,FF">
        <dip name="Freeze" bits="3" ids="Off,On" values="1,0"/>
        <dip name="Rack Test" bits="10" ids="Off,On" values="1,0"/>
        <dip name="Cabinet" bits="13" ids="Upright,Cocktail"/>
        <dip name="Lives" bits="14,15" ids="2,3,4,5" values="0,3,2,1"/>
        <dip name="Difficulty?" bits="8,9" ids="Easy,Medium,Hard,Hardest" values="3,2,1,0"/>
        <dip name="Flip Screen" bits="11" ids="Off,On" values="1,0"/>
        <dip name="Extra?" bits="12" ids="Easy,Hard" values="1,0"/>
        <dip name="Coin B" bits="16,19" ids="4C/1C,3C/1C,2C/1C,3C/2C,1C/1C,2C/3C,1C/2C,1C/3C,1C/4C,1C/5C,Free Play" values="6,8,10,7,15,9,14,13,12,11,0"/>
        <dip name="Coin A" bits="20,23" ids="4C/1C,3C/1C,2C/1C,3C/2C,1C/1C,2C/3C,1C/2C,1C/3C,1C/4C,1C/5C,Free Play" values="6,8,10,7,15,9,14,13,12,11,0"/>
    </switches>

